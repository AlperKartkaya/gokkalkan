{
  "name": "gokkalkan-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "bash scripts/setup_dev.sh",
    "setup:synthetic:blender": "bash scripts/setup_blender_macos.sh",
    "doctor": ".venv/bin/gokkalkan doctor --config config/runtime/sim.toml",
    "test:python": ".venv/bin/python -m pytest",
    "test:safety": ".venv/bin/python -m pytest -m safety",
    "test:protocol": ".venv/bin/python -m pytest -m protocol",
    "test:replay": ".venv/bin/python -m pytest -m replay",
    "test:hil": ".venv/bin/python -m pytest -m hil",
    "test:faults": ".venv/bin/gokkalkan quality faults",
    "test:soak": ".venv/bin/gokkalkan quality soak --duration-sec 1800 --step-sec 1",
    "dev:check": "npm run desktop:check",
    "desktop": "npm --prefix frontend run desktop --",
    "desktop:dev": "npm --prefix frontend run desktop:dev --",
    "desktop:check": "npm --prefix frontend run desktop:check --",
    "desktop:preview": "npm --prefix frontend run desktop:preview --",
    "test:desktop": "npm --prefix frontend run test:desktop --",
    "test:competition": "npm --prefix frontend run test:competition --",
    "build": "npm --prefix frontend run build --",
    "typecheck": "npm --prefix frontend run typecheck --",
    "test:unit": "npm --prefix frontend run test:unit --",
    "dataset:pull": ".venv-perception/bin/python perception/tools/dataset_pipeline.py pull-captures",
    "dataset:prepare": ".venv-perception/bin/python perception/tools/dataset_pipeline.py prepare",
    "dataset:cad:ingest": ".venv-synthetic/bin/python perception/tools/dataset_pipeline.py ingest-cad",
    "dataset:cad:inspect": ".venv-synthetic/bin/python perception/synthetic/tools/inspect_3mf.py",
    "dataset:cad:convert": ".venv-synthetic/bin/python perception/synthetic/tools/convert_cad_assets.py",
    "dataset:cad:lod": ".tools/blender-4.2.1/Blender.app/Contents/MacOS/Blender --background --python perception/synthetic/tools/generate_lods_blender.py --",
    "dataset:cad:validate": ".venv-synthetic/bin/python perception/synthetic/tools/validate_lods.py",
    "dataset:cad:validate:batch": ".venv-synthetic/bin/python perception/synthetic/tools/validate_render_batch.py",
    "dataset:cad:camera": ".venv-synthetic/bin/python perception/synthetic/tools/apply_camera_pipeline.py",
    "dataset:cad:views": ".venv-synthetic/bin/python perception/synthetic/tools/generate_inference_views.py",
    "dataset:cad:plan": ".venv-synthetic/bin/python perception/synthetic/tools/generate_scene_matrix.py",
    "dataset:cad:plan:pilot": ".venv-synthetic/bin/python perception/synthetic/tools/build_pilot_plan.py",
    "dataset:cad:render:pilot": ".venv-synthetic/bin/python perception/synthetic/tools/render_plan_batch.py",
    "dataset:cad:filter": ".venv-synthetic/bin/python perception/synthetic/tools/filter_render_plan.py",
    "dataset:cad:render:smoke": ".venv-synthetic/bin/blenderproc run --custom-blender-path .tools/blender-4.2.1/Blender.app perception/synthetic/tools/render_smoke.py",
    "dataset:cad:render:record": ".venv-synthetic/bin/blenderproc run --custom-blender-path .tools/blender-4.2.1/Blender.app perception/synthetic/tools/render_dataset.py",
    "model:train:smoke": ".venv-training/bin/python perception/tools/train_yolo.py --allow-unverified --epochs 1 --name target-smoke",
    "ml:setup": "bash scripts/setup_ml_pipeline.sh",
    "cad:render": "bash scripts/render_cad_dataset.sh",
    "cad:ingest": "bash scripts/ingest_cad_dataset.sh",
    "model:train": "bash scripts/train_target_detector.sh",
    "model:predict:val": "bash scripts/predict_target_val.sh"
  }
}
