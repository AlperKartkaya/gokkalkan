{
  "name": "gokkalkan-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "bash scripts/setup_dev.sh",
    "doctor": ".venv/bin/gokkalkan doctor --config config/runtime/sim.toml",
    "test:python": ".venv/bin/python -m pytest",
    "test:safety": ".venv/bin/python -m pytest -m safety",
    "test:protocol": ".venv/bin/python -m pytest -m protocol",
    "test:replay": ".venv/bin/python -m pytest -m replay",
    "test:hil": ".venv/bin/python -m pytest -m hil",
    "test:faults": ".venv/bin/gokkalkan quality faults",
    "test:soak": ".venv/bin/gokkalkan quality soak --duration-sec 1800 --step-sec 1",
    "dev:check": "npm run desktop:check",
    "desktop": "npm --prefix frontend run desktop --",
    "desktop:dev": "npm --prefix frontend run desktop:dev --",
    "desktop:check": "npm --prefix frontend run desktop:check --",
    "desktop:preview": "npm --prefix frontend run desktop:preview --",
    "test:desktop": "npm --prefix frontend run test:desktop --",
    "test:competition": "npm --prefix frontend run test:competition --",
    "build": "npm --prefix frontend run build --",
    "typecheck": "npm --prefix frontend run typecheck --",
    "test:unit": "npm --prefix frontend run test:unit --"
  }
}
