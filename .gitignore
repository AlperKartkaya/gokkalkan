# ==========================================
# Python & Virtual Environments
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
.venv-perception/
.venv-training/
venv/
env/
pip-log.txt
pip-delete-this-directory.txt

# ==========================================
# IDE & OS Specific Files
# ==========================================
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ==========================================
# ROS 2 & C++ Build Artifacts
# ==========================================
# If you use ROS2 Colcon workspaces or standard CMake
build/
install/
log/
CMakeCache.txt
CMakeFiles/
*.o
*.so
*.out

# ==========================================
# AI Models & Heavy Assets (Hailo/YOLO)
# ==========================================
# Git cannot handle large binaries well. Use Git LFS if you MUST track these, 
# otherwise, ignore them and download them directly to the Pi.
*.hef          
*.pt           
*.onnx         
*.weights

# ==========================================
# CAD Files
# ==========================================
Modeller.3mf

# CAD tabanlı sentetik veri hattı yalnız sözleşme ve araçları Git'te tutar.
# Normalize mesh, contact sheet, render ve inceleme raporları tekrar üretilebilir
# geliştirme artefaktlarıdır.
perception/synthetic/generated/*
!perception/synthetic/generated/.gitkeep

# ==========================================
# Telemetry & Logs (WP-05)
# ==========================================
# The operator UI and backend will generate lots of data. Do not push this.
*.csv
*.log
telemetry_data/
recordings/

# Perception capture/dataset/model çalışma alanları. Yalnız sözleşme,
# örnek metadata ve .gitkeep dosyaları repoda tutulur.
perception/dataset/captures/drop/*/
perception/dataset/captures/store/*
!perception/dataset/captures/store/.gitkeep
perception/dataset/captures/annotated/*/
perception/dataset/generated/*
!perception/dataset/generated/.gitkeep
perception/dataset/model_runs/*
!perception/dataset/model_runs/.gitkeep

# Ultralytics CLI'nin project verilmediğinde oluşturduğu prediction/val çıktıları.
runs/

# ==========================================
# PySide6 / Qt Build Files
# ==========================================
# If you compile UI files dynamically
ui_*.py
rc_*.py

# ==========================================
# Node.js & Frontend Build Artifacts
# ==========================================
node_modules/
dist/
dist-ssr/
test-results/
playwright-report/
*.local
.env
.env.*
!.env.example
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# Test Reports & Coverage
# ==========================================
.coverage
reports/test_report.html
reports/assets/
.pytest_cache/
# Local heavyweight development tools (for example Blender).
.tools/

# Local Hailo development environments and model zoo clones.
hailo_env/
hailo_model_zoo/
