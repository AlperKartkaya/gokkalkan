# Gökkalkan frontend mock mechanics defaults.
# Vite exposes only VITE_* variables to the browser bundle.

VITE_GOKKALKAN_PAN_MIN_DEG=-75
VITE_GOKKALKAN_PAN_MAX_DEG=75
VITE_GOKKALKAN_TILT_MIN_DEG=-10
VITE_GOKKALKAN_TILT_MAX_DEG=45
VITE_GOKKALKAN_COARSE_STEP_DEG=2
VITE_GOKKALKAN_FINE_STEP_DEG=0.5
VITE_GOKKALKAN_ARM_HOLD_MS=500
VITE_GOKKALKAN_ARM_TIMEOUT_MS=2500
VITE_GOKKALKAN_PREP_SECONDS=1800
VITE_GOKKALKAN_MAINTENANCE_BUDGET_SECONDS=600
VITE_GOKKALKAN_MAINTENANCE_MIN_SECONDS=30
VITE_GOKKALKAN_MOCK_CONNECTION_OK=true
VITE_GOKKALKAN_MOTION_FORBIDDEN_LABEL="arka ±105°"
VITE_GOKKALKAN_FIRE_FORBIDDEN_LABEL="seyirci ROI"
VITE_GOKKALKAN_REALWORLD_SIM_DEFAULT=false
VITE_GOKKALKAN_SIM_SENSOR_NOISE_PX=1.8
VITE_GOKKALKAN_SIM_LATENCY_MS=84
VITE_GOKKALKAN_SIM_PACKET_LOSS_PERCENT=0.7
VITE_GOKKALKAN_SIM_WIND_MPS=2.4
VITE_GOKKALKAN_SIM_BATTERY_START_V=15.8
VITE_GOKKALKAN_SIM_TOUR_SECONDS=22
VITE_GOKKALKAN_SIM_CAMERA_FOV_DEG=62
VITE_GOKKALKAN_SIM_LIDAR_RANGE_STD_M=0.08
VITE_GOKKALKAN_SIM_RADAR_RANGE_STD_M=0.18
VITE_GOKKALKAN_SIM_RADAR_SNR_DB=24

# Gerçek operatör paneli dry-run backend bağlantısı.
# Backend örneği:
# PYTHONPATH=backend/src python3 -m gokkalkan_backend.operator_http_server --host 127.0.0.1 --port 8088
VITE_GOKKALKAN_OPERATOR_API_BASE=http://127.0.0.1:8088
VITE_GOKKALKAN_OPERATOR_LIVE_ARMED=0
