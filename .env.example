# Gökkalkan Environment Config Template
# Copy this file to .env and adjust values for your environment.

OPERATOR_API_HOST=127.0.0.1
OPERATOR_API_PORT=8088

# Backend authority comes from a validated TOML profile, not client flags.
GOKKALKAN_RUNTIME_CONFIG=config/runtime/sim.toml
GOKKALKAN_RUNTIME_MODE=SIM
