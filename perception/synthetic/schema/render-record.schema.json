{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gokkalkan.local/schema/render-record.schema.json",
  "title": "Gökkalkan Synthetic Render Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordId",
    "worldId",
    "variantId",
    "groupId",
    "sourceKind",
    "split",
    "assetKey",
    "presentationClass",
    "cameraProfileId",
    "yawComputation",
    "lateralDistanceBucketM",
    "lateralDistanceM",
    "longitudinalDistanceM",
    "routeId",
    "appearanceProfileId",
    "distanceM",
    "targetPositionM",
    "viewYawDeg",
    "topSurfaceViewBucketDeg",
    "topSurfaceViewDeg",
    "targetRotationWorld3x3",
    "cameraElevationOffsetDeg",
    "sceneGroundTruth",
    "zoom"
  ],
  "properties": {
    "recordId": {
      "type": "string",
      "minLength": 1
    },
    "worldId": {
      "type": "string",
      "minLength": 1
    },
    "variantId": {
      "type": "string",
      "minLength": 1
    },
    "groupId": {
      "type": "string",
      "minLength": 1
    },
    "sourceKind": {
      "enum": [
        "synthetic_seed_2d",
        "synthetic_cad_pbr",
        "synthetic_cad_dr",
        "synthetic_cad_hybrid",
        "real_background_only",
        "real_capture"
      ]
    },
    "split": {
      "enum": [
        "train",
        "val",
        "test"
      ]
    },
    "assetKey": {
      "type": "string",
      "minLength": 1
    },
    "presentationClass": {
      "type": "string",
      "minLength": 1
    },
    "cameraProfileId": {
      "type": "string",
      "minLength": 1
    },
    "distanceM": {
      "type": "number",
      "minimum": 3,
      "maximum": 17.27
    },
    "targetPositionM": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "viewYawDeg": {
      "type": "number",
      "minimum": -45,
      "maximum": 45
    },
    "topSurfaceViewBucketDeg": {
      "type": "number",
      "minimum": 4,
      "maximum": 28
    },
    "topSurfaceViewDeg": {
      "type": "number",
      "minimum": 3.5,
      "maximum": 28.5
    },
    "targetRotationWorld3x3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "number"
        }
      }
    },
    "cameraElevationOffsetDeg": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "zoom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "factor",
        "cropRectPx",
        "preCropResolution",
        "postCropResolution",
        "modelInputResolution",
        "interpolation",
        "targetPixelsBeforeZoom",
        "targetPixelsAfterZoom",
        "zoomCenterErrorPx"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "sensor_roi",
            "high_res_roi",
            "scaler_crop",
            "application_crop"
          ]
        },
        "factor": {
          "enum": [
            1.0,
            1.5,
            2.0,
            3.0
          ]
        },
        "cropRectPx": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "preCropResolution": {
          "$ref": "#/$defs/resolution"
        },
        "postCropResolution": {
          "$ref": "#/$defs/resolution"
        },
        "modelInputResolution": {
          "$ref": "#/$defs/resolution"
        },
        "interpolation": {
          "type": "string",
          "minLength": 1
        },
        "targetPixelsBeforeZoom": {
          "type": "integer",
          "minimum": 0
        },
        "targetPixelsAfterZoom": {
          "type": "integer",
          "minimum": 0
        },
        "zoomCenterErrorPx": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "acquisitionPath": {
          "enum": [
            "FULL_FOV_LORES",
            "FULL_FOV_HIGH_RES_MAIN_SOFTWARE_CROP",
            "PICAMERA2_SCALER_CROP_PROXY",
            "LOW_RESOLUTION_APPLICATION_BASELINE"
          ]
        },
        "modelContentRectPx": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "modelScale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "modelPaddingPx": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "upsampledBeforeModel": {
          "type": "boolean"
        },
        "cameraDegradation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profileStatus",
            "blurKernel",
            "noiseStd",
            "codec",
            "jpegQuality",
            "seed"
          ],
          "properties": {
            "profileStatus": {
              "enum": [
                "IDEAL_NO_MEASURED_CAMERA_DEGRADATION",
                "PROVISIONAL_RESEARCH_SWEEP",
                "VERIFIED_PHYSICAL_PROFILE"
              ]
            },
            "blurKernel": {
              "enum": [
                0,
                3,
                5
              ]
            },
            "noiseStd": {
              "type": "number",
              "minimum": 0,
              "maximum": 20
            },
            "codec": {
              "enum": [
                "none",
                "jpeg"
              ]
            },
            "jpegQuality": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 40,
              "maximum": 100
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "appearanceProfileId": {
      "enum": [
        "nominal",
        "slightly_faded",
        "dim_environment",
        "bright_environment"
      ]
    },
    "routeId": {
      "enum": [
        "ROTA_1",
        "ROTA_2",
        "ROTA_3"
      ]
    },
    "longitudinalDistanceM": {
      "type": "number",
      "minimum": 3,
      "maximum": 17
    },
    "lateralDistanceM": {
      "type": "number",
      "minimum": -3,
      "maximum": 3
    },
    "lateralDistanceBucketM": {
      "type": "number",
      "minimum": -3,
      "maximum": 3
    },
    "yawComputation": {
      "const": "ATAN2_SIGNED_LATERAL_OVER_LONGITUDINAL"
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bboxBeforeZoomPx",
        "bboxAfterZoomPx",
        "targetVisibleAfterZoom"
      ],
      "properties": {
        "bboxBeforeZoomPx": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/bbox"
            }
          ]
        },
        "bboxAfterZoomPx": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/bbox"
            }
          ]
        },
        "targetVisibleAfterZoom": {
          "type": "boolean"
        }
      }
    },
    "sceneGroundTruth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetInstanceId",
        "eligibleStageIds",
        "friendFoe",
        "balloon"
      ],
      "properties": {
        "targetInstanceId": {
          "type": "string",
          "minLength": 1
        },
        "eligibleStageIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ASAMA_1",
              "ASAMA_2",
              "ASAMA_3"
            ]
          }
        },
        "friendFoe": {
          "enum": [
            "Dost",
            "Düşman"
          ]
        },
        "balloon": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "instanceId",
            "targetInstanceId",
            "diameterM",
            "relativeCenterM",
            "colorHex",
            "fireCandidateAllowed"
          ],
          "properties": {
            "instanceId": {
              "type": "string",
              "minLength": 1
            },
            "targetInstanceId": {
              "type": "string",
              "minLength": 1
            },
            "diameterM": {
              "type": "number",
              "minimum": 0.12,
              "maximum": 0.16
            },
            "relativeCenterM": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "colorHex": {
              "const": "#F50A0A"
            },
            "fireCandidateAllowed": {
              "type": "boolean"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "resolution": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
