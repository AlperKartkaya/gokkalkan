{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gokkalkan.local/schema/cad-source.schema.json",
  "title": "Gökkalkan CAD Source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assetId",
    "localFileName",
    "expectedSha256",
    "status"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "assetId": {"type": "string", "pattern": "^[A-Z0-9_-]+$"},
    "localFileName": {"type": "string", "minLength": 1},
    "expectedSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"const": "LOCAL_WORKSPACE_VERIFIED_HASH"},
    "notes": {"type": "string"}
  }
}
