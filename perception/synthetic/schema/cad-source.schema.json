{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gokkalkan.local/schema/cad-source.schema.json",
  "title": "Gökkalkan CAD Source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assetId",
    "localFileName",
    "expectedSha256",
    "status",
    "sourceUri",
    "owner",
    "licenseOrPermission"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "assetId": {"type": "string", "pattern": "^[A-Z0-9_-]+$"},
    "localFileName": {"type": "string", "minLength": 1},
    "expectedSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {
      "enum": ["LOCAL_ONLY_PENDING_PROVENANCE", "VERIFIED_SHARED_SOURCE"]
    },
    "sourceUri": {"type": ["string", "null"], "format": "uri"},
    "owner": {"type": ["string", "null"]},
    "licenseOrPermission": {"type": ["string", "null"]},
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "VERIFIED_SHARED_SOURCE"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "sourceUri": {"type": "string", "format": "uri", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "licenseOrPermission": {"type": "string", "minLength": 1}
        }
      }
    }
  ]
}
