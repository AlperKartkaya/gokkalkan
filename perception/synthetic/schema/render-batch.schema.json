{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gokkalkan.local/schema/render-batch.schema.json",
  "title": "Gökkalkan Synthetic Render Batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "batchId",
    "status",
    "sourceCadSha256",
    "assetManifestSha256",
    "renderer",
    "records"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "batchId": {"type": "string", "minLength": 1},
    "status": {
      "enum": [
        "SYNTHETIC_RENDER_PLAN",
        "SYNTHETIC_RESEARCH_ONLY",
        "CAMERA_CALIBRATED_RESEARCH"
      ]
    },
    "sourceCadSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "assetManifestSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blenderProcVersion", "blenderVersion", "seed"],
      "properties": {
        "blenderProcVersion": {"type": "string", "minLength": 1},
        "blenderVersion": {"type": "string", "minLength": 1},
        "seed": {"type": "integer", "minimum": 0}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "longitudinalDistanceM",
        "topSurfaceViewBucketDeg",
        "yawPolicy",
        "recordCount"
      ],
      "properties": {
        "longitudinalDistanceM": {
          "type": "array",
          "items": {"type": "number", "minimum": 3, "maximum": 17},
          "minItems": 1,
          "uniqueItems": true
        },
        "topSurfaceViewBucketDeg": {
          "type": "array",
          "items": {"type": "number", "minimum": 4, "maximum": 28},
          "minItems": 1,
          "uniqueItems": true
        },
        "yawPolicy": {"const": "DERIVED_FROM_ALL_ROUTE_POSITIONS"},
        "recordCount": {"type": "integer", "minimum": 1}
      }
    },
    "records": {
      "type": "array",
      "items": {"$ref": "render-record.schema.json"}
    }
  }
}
