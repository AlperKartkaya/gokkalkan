[Unit]
Description=Gökkalkan camera and perception bridge
ConditionPathExists=/etc/gokkalkan/enable-perception
Requires=gokkalkan-backend.service
After=gokkalkan-backend.service

[Service]
Type=simple
User=gokkalkan
Group=gokkalkan
SupplementaryGroups=video render
WorkingDirectory=/opt/gokkalkan
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/gokkalkan/perception.env
ExecStart=/opt/gokkalkan/.venv/bin/python /opt/gokkalkan/perception/src/perception_bridge.py --url http://127.0.0.1:8088 --poll-hz 30 --backend picamera2 --require-accelerator --require-detector --hailo-model /opt/gokkalkan/perception/models/target_detector.hef --camera-calibration /etc/gokkalkan/calibration/camera.toml --search-config /opt/gokkalkan/config/perception/search.toml
Restart=on-failure
RestartSec=3
TimeoutStopSec=8
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gokkalkan
# Picamera2/libcamera discovers a changing set of media, video-subdevice and
# DMA-heap nodes on Raspberry Pi 5. Keep Unix group/device permissions as the
# boundary instead of an incomplete systemd DeviceAllow list that hides the
# physically present camera from libcamera.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gokkalkan-perception

[Install]
WantedBy=gokkalkan.target
